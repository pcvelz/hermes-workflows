<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Skeleton for scripts/install-services.py. The installer replaces the __X__
     placeholders, then merges the per-service keys from services/services.yaml
     (KeepAlive, RunAtLoad, StartInterval, WatchPaths, extra env, key refs). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROGRAM__</string>
        <string>__PAYLOAD__</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HERMES_HOME</key>
        <string>__HERMES_HOME__</string>
        <key>HERMES_KEYS_DIR</key>
        <string>__HERMES_KEYS_DIR__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
