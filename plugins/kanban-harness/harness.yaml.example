# @user-gated
# Source of truth: https://github.com/pcvelz/hermes-workflows/blob/main/plugins/kanban-harness/harness.yaml.example
# kanban-harness — the board transition matrix, as data.
#
# Copy to harness.yaml (git-ignored) next to this file, or point KANBAN_HARNESS_FILE at
# your own copy. With no harness.yaml the plugin enforces THIS template.
#
# The plugin has no workflow built in: it only interprets `transitions`. For every agent
# kanban tool call and every `hermes kanban <verb>` in a shell/code tool, it looks for a
# row granting the caller's role that action; anything not listed is refused.
#
# This template reproduces the default matrix (see docs/kanban-harness.md):
#   the first work column -> ready -> running    dispatcher only (promote + spawn assignee)
#   coding  -> hand-off to qa                    kanban_handoff
#   qa      -> hand-off to the user              kanban_handoff (task parked, see status)
#   user (the person) -> done, or rework         the human's own CLI / dashboard only
# No row lets an agent complete, block, unblock, promote, assign or reassign.
# No agent reaches `done`, ever -- not even for a child card.

# The harness always enforces: a move the table does not allow is refused, and
# logged. There is no mode to make it merely observe, and no switch to disable it.
# Where refusals are written: the shared home, not $HERMES_HOME (a worker's
# HERMES_HOME is its own profile dir).
log_file: ~/.hermes/logs/kanban-harness.log

# ----------------------------------------------------------------------------------
# Default matrix (used by every board below that does not override a key).
# ----------------------------------------------------------------------------------
roles:
  coding:
    profiles: [coder]
  qa:
    profiles: [qa-tester]
  user:
    # The person. A human lane: the assignee name is used verbatim and must NOT
    # be a Hermes profile, so the dispatcher never spawns a worker for it. That
    # absence is load-bearing: upstream's dispatcher also spawns the assignee of
    # any `review` card that maps to a real profile (docs/board-design.md D9).
    human: true
    assignee: user
  # A role with no `profiles` key is a single profile named as its own role, e.g.
  # planner: {}

transitions:
  # from_role   who may move            (a role above)
  # action      complete | block | unblock | create | link | handoff | <any
  #             `hermes kanban` verb, e.g. comment, assign, promote …>
  # via         tool (default) and/or shell (`hermes kanban <action>` from a shell)
  # when        any (default) | root | non_root   — level 0 = no parent task, or the
  #             task body matches root_marker
  # requires    optional evidence: {files: <glob in the worker's workspace>,
  #             matches: <regex a matching file must contain>}; refused until met
  # to_role / status   handoff only: the target role and the task's status after the
  #             hand-off (ready = the dispatcher spawns the target; blocked = parked
  #             until a human acts, which also keeps it out of stranded_in_ready alerts)
  - {from_role: coding, action: handoff, to_role: qa, status: ready}
  # QA's pass lands in user_review: status `scheduled`, which nothing dispatches
  # from and which the runtime's `complete` refuses -- so the user's `accept`
  # (scripts/resilience/board_cli.py) is the only way from here to done.
  - {from_role: qa, action: handoff, to_role: user, status: scheduled}
  # Rework: QA sends the card back to coding, naming what failed (to_role: coding).
  - {from_role: qa, action: handoff, to_role: coding, status: ready}
  # A question: the worker cannot continue until a person decides -- for
  # example the card has no acceptance criteria. kanban_handoff(question=true)
  # parks it for the user; the worker never guesses instead.
  - {from_role: coding, action: handoff, to_role: user, status: blocked}
  - {from_role: qa, action: handoff, to_role: user, status: blocked}
  - {from_role: coding, action: create}          # sub-tasks / fan-out keep working
  - {from_role: coding, action: link}
  - {from_role: qa, action: create}
  - {from_role: qa, action: link}
  # There is deliberately NO row granting any agent `complete`. An earlier
  # "sub-task gate" let QA finish child cards; it was dropped because no agent may
  # reach done, ever. With config/board.yaml deployed, a row like that makes the
  # harness refuse to load. See docs/kanban-harness.md.
  # Evidence gate: refuse a hand-off until the workspace holds matching evidence.
  # - {from_role: coding, action: handoff, to_role: qa, status: ready,
  #    requires: {files: "findings/**/*.md", matches: '(?m)^Verified: yes$'}}
  # Scripted fan-out from a shell (still no complete/block/unblock from a shell):
  # - {from_role: coding, action: create, via: [tool, shell]}
  # - {from_role: coding, action: link, via: [tool, shell]}

# Level-0 marker (Python regex) in a task body; tasks without parents are level 0 too.
root_marker: '(?mi)^\s*Level:\s*0\s*$'

# Moves open to every profile, role or not: reading the board and talking on it.
always_allow:
  tools: [kanban_show, kanban_list, kanban_heartbeat, kanban_comment]
  shell_verbs: [list, ls, show, tail, watch, stats, diagnostics, context, runs, log,
                help, "boards list", "boards ls"]

# A profile in no role is always denied. (There is no `unknown_profile: allow`.)

# Side doors. ALWAYS on, and the baseline is built into the harness: the kanban
# database and its accept ledger, the kanban_db module, the dashboard kanban
# API and the user's board_cli command are refused in every agent shell and code
# tool whatever this file says. Patterns listed here are ADDED to that baseline;
# nothing here can remove one.
side_doors:
  deny_patterns: []
  deny_path_patterns: []

# ----------------------------------------------------------------------------------
# Boards. EVERY board is harnessed. A mapping lets a board override roles,
# transitions, always_allow, root_marker or side_doors (each replaced as a whole,
# and every override still subject to the built-in baseline). A board not listed
# here gets the default table -- never no table.
# ----------------------------------------------------------------------------------
boards:
  "*": {}
  # project-a:
  #   roles:
  #     coding: {profiles: [coder]}
  #     qa: {profiles: [qa-tester]}
  #     user: {human: true, assignee: user}
  #   transitions:
  #     - {from_role: coding, action: handoff, to_role: qa, status: ready}
  #     - {from_role: qa, action: handoff, to_role: user, status: scheduled}
  #     - {from_role: coding, action: create, via: [tool, shell]}
