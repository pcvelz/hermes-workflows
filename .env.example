# Source of truth: https://github.com/pcvelz/hermes-workflows/blob/main/.env.example
# =============================================================================
# Hermes Workflows — RUNTIME environment template ($HERMES_HOME/.env)
# =============================================================================
# This is the runtime env consumed directly by the `hermes` CLI / agent
# process (LLM provider keys, tool API keys, terminal/browser backend
# knobs, chat-platform tokens). It is DIFFERENT from `docker/.env.example`,
# which only configures the Docker Compose stack (image, ports, DB
# passwords) — that file never touches API keys or model config.
#
# Copy this file to `.env` at the repo root (or to `$HERMES_HOME/.env` if
# your runtime home lives elsewhere) and fill in your own values.
# `.env` is gitignored — never commit real values.
#
# Every value below is a PLACEHOLDER or left blank/commented. No real
# secrets, tokens, hosts, or personal paths should ever be committed.
# =============================================================================

# =============================================================================
# LLM PROVIDER — pick ONE inference path and fill in only what it needs.
# See docs/backend.md for the full provider matrix (cloud vs local).
# =============================================================================

# --- Cloud: Anthropic-compatible endpoint (also used for local backends that
#     speak the Anthropic Messages protocol, e.g. a local llama.cpp/llama-swap
#     proxy — see docs/backend.md for the local-backend recipe) ---
# HERMES_INFERENCE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<your-anthropic-api-key-or-local-placeholder>
# ANTHROPIC_BASE_URL=<https://api.anthropic.com-or-your-local-proxy-url>
# ANTHROPIC_MODEL=<provider-model-id>

# --- Cloud: OpenRouter (access to many models through one API) ---
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# --- Cloud: NovitaAI ---
# Get your key at: https://novita.ai/settings/key-management
# NOVITA_API_KEY=
# NOVITA_BASE_URL=

# --- Cloud: Google AI Studio / Gemini ---
# Get your key at: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=
# GEMINI_API_KEY=            # alias for GOOGLE_API_KEY
# GEMINI_BASE_URL=

# --- Cloud: z.ai / GLM ---
# Get your key at: https://z.ai or https://open.bigmodel.cn
# GLM_API_KEY=
# GLM_BASE_URL=

# --- Cloud: Kimi / Moonshot ---
# Get your key at: https://platform.kimi.ai (Kimi Code console)
# KIMI_API_KEY=
# KIMI_BASE_URL=
# KIMI_CN_API_KEY=           # dedicated Moonshot China key

# --- Cloud: Arcee AI ---
# Get your key at: https://chat.arcee.ai/
# ARCEEAI_API_KEY=
# ARCEE_BASE_URL=

# --- Cloud: MiniMax ---
# Get your key at: https://www.minimax.io
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=
# MINIMAX_CN_API_KEY=
# MINIMAX_CN_BASE_URL=

# --- Cloud: OpenCode Zen / OpenCode Go ---
# Get your key at: https://opencode.ai/auth
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_BASE_URL=
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_BASE_URL=

# --- Cloud: Hugging Face Inference Providers ---
# Get your token at: https://huggingface.co/settings/tokens
# (needs the "Make calls to Inference Providers" permission)
# HF_TOKEN=

# --- Cloud: Qwen OAuth (reuses local `qwen auth qwen-oauth` login; no key) ---
# HERMES_QWEN_BASE_URL=

# --- Cloud: Xiaomi MiMo ---
# Get your key at: https://platform.xiaomimimo.com
# XIAOMI_API_KEY=
# XIAOMI_BASE_URL=

# =============================================================================
# TOOL API KEYS (optional — only needed if you enable the corresponding tool)
# =============================================================================
# EXA_API_KEY=                # https://exa.ai — AI-native web search/contents
# PARALLEL_API_KEY=           # https://parallel.ai — AI-native web search/extract
# FIRECRAWL_API_KEY=          # https://firecrawl.dev/ — web search/extract/crawl
# FAL_KEY=                    # https://fal.ai/ — image generation
# HONCHO_API_KEY=             # https://app.honcho.dev — cross-session user modeling
# GITHUB_TOKEN=                # https://github.com/settings/tokens — skills hub API rate limit
# GROQ_API_KEY=                # free-tier Whisper STT for voice mode

# =============================================================================
# TERMINAL TOOL CONFIGURATION
# =============================================================================
# Backend is normally set in config.yaml (terminal.backend). Override here
# only if you need to force it without touching config.yaml.
# TERMINAL_ENV=<local|docker|singularity|modal|ssh>
# HERMES_DOCKER_BINARY=<path-to-docker-or-podman-binary>
# TERMINAL_DOCKER_IMAGE=<image-name>
# TERMINAL_SINGULARITY_IMAGE=<docker://image-name>
# TERMINAL_MODAL_IMAGE=<image-name>
# TERMINAL_CWD=<absolute-path-inside-the-target-environment>
# TERMINAL_TIMEOUT=<seconds>
# TERMINAL_LIFETIME_SECONDS=<seconds>

# --- SSH remote execution (TERMINAL_ENV=ssh) ---
# TERMINAL_SSH_HOST=
# TERMINAL_SSH_USER=
# TERMINAL_SSH_PORT=
# TERMINAL_SSH_KEY=<path-to-private-key>

# --- Sudo support (all terminal backends) ---
# SECURITY WARNING: stored in plaintext — only use on trusted machines.
# SUDO_PASSWORD=

# =============================================================================
# BROWSER TOOL CONFIGURATION (agent-browser + Browserbase)
# =============================================================================
# BROWSERBASE_API_KEY=         # https://browserbase.com/
# BROWSERBASE_PROJECT_ID=
# BROWSERBASE_PROXIES=<true|false>
# BROWSERBASE_ADVANCED_STEALTH=<true|false>   # Scale Plan only
# AGENT_BROWSER_ENGINE=<auto|chrome|lightpanda>
# AGENT_BROWSER_EXECUTABLE_PATH=<path-to-local-chrome-or-chromium-binary>
# BROWSER_SESSION_TIMEOUT=<seconds>
# BROWSER_INACTIVITY_TIMEOUT=<seconds>
# AGENT_BROWSER_ARGS=<comma-or-newline-separated-chromium-flags>
# CAMOFOX_URL=<http://localhost:PORT>          # local Camoufox anti-detection browser
# CAMOFOX_USER_ID=
# CAMOFOX_SESSION_KEY=
# CAMOFOX_ADOPT_EXISTING_TAB=<true|false>

# =============================================================================
# VOICE TRANSCRIPTION & OPENAI TTS
# =============================================================================
# VOICE_TOOLS_OPENAI_KEY=      # https://platform.openai.com/api-keys
# STT_GROQ_MODEL=
# STT_OPENAI_MODEL=
# GROQ_BASE_URL=
# STT_OPENAI_BASE_URL=

# =============================================================================
# CHAT PLATFORM INTEGRATIONS (gateway) — enable only the ones you use
# =============================================================================
# Gateway-wide: allow ALL users without a per-platform allowlist.
# Default is deny (false). Leave false/unset unless you intentionally want
# open access — a public/discoverable channel MUST carry an allowlist instead.
# GATEWAY_ALLOW_ALL_USERS=false

# --- Slack ---
# SLACK_BOT_TOKEN=<xoxb-...>          # OAuth & Permissions in your Slack App
# SLACK_APP_TOKEN=<xapp-...>          # Socket Mode app-level token
# SLACK_ALLOWED_USERS=                # comma-separated Slack user IDs

# --- Telegram ---
# TELEGRAM_BOT_TOKEN=                 # from @BotFather
# TELEGRAM_ALLOWED_USERS=             # comma-separated user IDs
# TELEGRAM_HOME_CHANNEL=              # default chat for cron delivery
# TELEGRAM_HOME_CHANNEL_NAME=
# TELEGRAM_CRON_THREAD_ID=
# TELEGRAM_WEBHOOK_URL=               # switches from long-polling to webhook mode
# TELEGRAM_WEBHOOK_PORT=
# TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp (built-in Baileys bridge — `hermes whatsapp` to pair) ---
# WHATSAPP_ENABLED=<true|false>
# WHATSAPP_ALLOWED_USERS=             # comma-separated phone numbers

# --- Email (IMAP/SMTP) ---
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=                     # app password, not your account password
# EMAIL_IMAP_HOST=
# EMAIL_IMAP_PORT=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_POLL_INTERVAL=
# EMAIL_ALLOWED_USERS=
# EMAIL_HOME_ADDRESS=

# --- Microsoft Teams ---
# TEAMS_CLIENT_ID=                    # Azure AD App (client) ID
# TEAMS_CLIENT_SECRET=                # Azure AD client secret value
# TEAMS_TENANT_ID=                    # Azure AD tenant ID (or "common")
# TEAMS_ALLOWED_USERS=                # comma-separated AAD object IDs or UPNs
# TEAMS_ALLOW_ALL_USERS=<true|false>
# TEAMS_HOME_CHANNEL=
# TEAMS_HOME_CHANNEL_NAME=
# TEAMS_PORT=

# --- Google Chat (Cloud Pub/Sub pull subscription) ---
# GOOGLE_CHAT_PROJECT_ID=
# GOOGLE_CHAT_SUBSCRIPTION_NAME=
# GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=   # path to service-account JSON key
# GOOGLE_CHAT_ALLOWED_USERS=
# GOOGLE_CHAT_ALLOW_ALL_USERS=<true|false>
# GOOGLE_CHAT_HOME_CHANNEL=
# GOOGLE_CHAT_HOME_CHANNEL_NAME=

# --- Mattermost ---
# See config/profiles/orchestrator/.env.example for the full Mattermost
# gateway var set (URL, token, home channel, mention/allow-all knobs).

# =============================================================================
# RESPONSE PACING
# =============================================================================
# HERMES_HUMAN_DELAY_MODE=<off|natural|custom>
# HERMES_HUMAN_DELAY_MIN_MS=
# HERMES_HUMAN_DELAY_MAX_MS=

# =============================================================================
# DEBUG OPTIONS
# =============================================================================
# WEB_TOOLS_DEBUG=<true|false>
# VISION_TOOLS_DEBUG=<true|false>
# MOA_TOOLS_DEBUG=<true|false>
# IMAGE_TOOLS_DEBUG=<true|false>

# =============================================================================
# CONTEXT COMPRESSION
# =============================================================================
# Most of this is set in config.yaml (compression:) — override here only
# if you need an env-level knob.
# CONTEXT_COMPRESSION_ENABLED=<true|false>
# CONTEXT_COMPRESSION_THRESHOLD=<0.0-1.0>
