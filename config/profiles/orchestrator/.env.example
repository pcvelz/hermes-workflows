# =============================================================================
# Orchestrator profile — PER-PROFILE environment template
# =============================================================================
# Copy to: $HERMES_HOME/profiles/orchestrator/.env
# `config/profiles/*/.env` is gitignored — never commit real values.
#
# This is separate from the root `.env.example` (runtime-wide provider/tool
# keys). Per-profile env holds the chat-GATEWAY credentials/settings for
# whichever platform this profile is wired to via `platform_toolsets` in
# config.yaml.example — the orchestrator is the profile in this scaffold
# that owns human-facing chat/notification (see its config.yaml.example).
#
# The shipped orchestrator example wires Telegram (`platform_toolsets.telegram:
# [hermes-telegram]`). Mattermost is included below too, since it's a
# built-in gateway platform (see README's chat-channel table) commonly used
# as the primary two-way chat channel — swap in whichever platform(s) you
# actually enable in this profile's platform_toolsets.
#
# All values below are placeholders only. No real tokens, URLs, or channel
# IDs from any live deployment are included.
# =============================================================================

# =============================================================================
# GATEWAY — platform-agnostic
# =============================================================================
# Allow ALL users on every enabled platform without a per-platform allowlist.
# Default is deny (false/unset). Leave unset unless you intentionally want
# open access. A public/discoverable channel (e.g. Telegram) MUST carry an
# explicit allowlist instead of relying on this flag.
# GATEWAY_ALLOW_ALL_USERS=false

# =============================================================================
# TELEGRAM (matches this profile's shipped config.yaml.example wiring)
# =============================================================================
# Bot token from @BotFather (https://t.me/BotFather).
# TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>

# Comma-separated Telegram user/chat IDs allowed to talk to this profile.
# Referenced by config.yaml.example as telegram.allowed_chats.
# TELEGRAM_ALLOWED_USERS=<your-telegram-chat-id>

# Default chat for cron/notification delivery.
# TELEGRAM_HOME_CHANNEL=<your-telegram-chat-id>
# TELEGRAM_HOME_CHANNEL_NAME=<display-name-for-home-channel>

# Forum topic ID for cron deliveries (overrides TELEGRAM_HOME_CHANNEL_THREAD_ID
# for cron so replies land in the right topic).
# TELEGRAM_CRON_THREAD_ID=

# Webhook mode (optional — default is long polling).
# TELEGRAM_WEBHOOK_URL=<https://your-app.example.com/telegram>
# TELEGRAM_WEBHOOK_PORT=8443
# TELEGRAM_WEBHOOK_SECRET=<random-secret>

# =============================================================================
# MATTERMOST (built-in gateway platform — enable via platform_toolsets.mattermost
# in this profile's config.yaml if you use Mattermost instead of/alongside Telegram)
# =============================================================================
# Base URL of your Mattermost server.
# MATTERMOST_URL=<https://your-mattermost-server.example.com>

# Bot account personal access token (mint via `mmctl token generate` for a
# bot user; rotate periodically).
# MATTERMOST_TOKEN=<your-mattermost-bot-token>

# Whether the bot only replies when @-mentioned (true) or replies to every
# message in channels it's a member of (false).
# MATTERMOST_REQUIRE_MENTION=true

# Default channel ID for cron/notification delivery.
# MATTERMOST_HOME_CHANNEL=<your-channel-id>

# Comma-separated Mattermost user IDs allowed to talk to the bot on this
# platform (used instead of / in addition to GATEWAY_ALLOW_ALL_USERS).
# MATTERMOST_ALLOWED_USERS=<your-mattermost-user-id>
