# =============================================================================
# Hermes Workflows — Docker environment template
# =============================================================================
# Copy this file to .env (which is gitignored), then edit the placeholders.
# Launch: HERMES_UID=$(id -u) HERMES_GID=$(id -g) docker compose --env-file .env up -d
#
# All values in this file are PLACEHOLDERS. No real secrets, tokens, or
# personal paths should ever be committed. See .gitignore.
# =============================================================================

# --- Host user mapping (must match the owner of HERMES_HOME) ---------------
HERMES_UID=10000        # set to: id -u    (the host user owning HERMES_HOME)
HERMES_GID=10000        # set to: id -g

# --- Hermes runtime home ---------------------------------------------------
# Use an absolute path for Docker — ~ may not expand in all contexts.
HERMES_HOME=~/.hermes

# Role profile loaded by the agent.
# Conceptual roles: orchestrator | coder | planner | qa-tester
# Map to the profile names in your ~/.hermes/profiles/ directory.
HERMES_PROFILE=orchestrator

# Agent image. See docker-compose.yml — this image is UNVERIFIED / may not be
# published. Consider building from a local source checkout instead.
HERMES_IMAGE=ghcr.io/nousresearch/hermes-agent:latest

# Path to a local hermes-agent checkout — used only if you uncomment the
# build: stanza in docker-compose.yml.
HERMES_AGENT_SRC=../.hermes-agent

# Port the Hermes gateway listens on (bound to 127.0.0.1 only)
HERMES_GATEWAY_PORT=9876

# --- LLM backend (bring your own) -----------------------------------------
# Point at any OpenAI- or Anthropic-compatible endpoint.
# The recommended default is a local llama-swap proxy speaking the Anthropic
# Messages protocol; llama.cpp or LM Studio work equally well, together or
# separately. Replace <PORT> (and the host, if you are not on Docker Desktop)
# with your proxy's details. For a hosted Anthropic-compatible cloud endpoint
# instead, set LLM_BASE_URL to that provider's URL.
#
# Native Anthropic-protocol endpoint — NO /v1 suffix; the SDK appends
# /v1/messages automatically. In Docker a loopback-bound proxy is reached via
# host.docker.internal (see docker/README.md → "Backend reachability").
LLM_BASE_URL=http://host.docker.internal:<PORT>

# Model id as the backend expects it (the alias your proxy exposes,
# e.g. qwen3-35b or llama-3.1-8b).
HERMES_MODEL=<your-model-alias>

# API key / bearer token for the backend. For a local proxy any non-empty value
# works ("local" is conventional) and many proxies ignore it entirely, so an
# empty value is fine too. For a hosted backend supply the real key at runtime
# via Secrets-Kit or 1Password — do NOT paste a real key in this file.
# See docs/secrets.md.
# macOS (Secrets-Kit):  seckit run --service hermes --names LLM_API_KEY -- docker compose up -d
# 1Password:            op run --env-file=<(echo LLM_API_KEY=op://vault/item/field) -- docker compose up -d
LLM_API_KEY=

# Optional: OpenAI-compatible endpoint (if your backend exposes one).
# Leave blank if you use only the native-Anthropic path above.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Client read timeout in seconds. If your backend has cold-start latency (e.g.
# a self-hosted model loading into VRAM on first request), set this >=120.
# A hosted cloud API typically needs only 30–60s.
HERMES_HTTP_TIMEOUT=120

# --- pi-coding-agent worker (OPTIONAL) ------------------------------------
# PI_OFFLINE=1 prevents pi from contacting external APIs. Combine with
# an empty LLM_API_KEY / ANTHROPIC_API_KEY to prevent any cloud routing.
PI_OFFLINE=1

# Extra flags passed to pi-coding-agent (optional)
PI_ARGS=

# --- Claude Code worker (OPTIONAL) ----------------------------------------
# CLAUDE_OFFLINE=1 sets CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 inside the
# container, stopping Claude Code from making non-essential outbound calls
# (telemetry, auto-update, error reporting). Combined with an ANTHROPIC_BASE_URL
# pointed at your local backend (and no cloud ANTHROPIC_API_KEY), this keeps the
# worker on your own backend only.
CLAUDE_OFFLINE=1

# Extra flags passed to the `claude` CLI (optional), e.g. --model <alias>.
CLAUDE_ARGS=

# --- SearXNG (private web search, published on 127.0.0.1:8888) -------------
SEARXNG_PORT=8888

# REQUIRED — generate with: openssl rand -hex 32.
# Compose refuses to start until this is set (fail-closed).
SEARXNG_SECRET=

SEARXNG_IMAGE=searxng/searxng:latest

# --- Hindsight (pgvector semantic memory, published on 127.0.0.1:8889) -----
# NOTE: bare pgvector substrate — no ingest API wired. Proposed design only.
HINDSIGHT_PORT=8889
HINDSIGHT_DB_USER=hindsight

# REQUIRED — set a strong, unique password. No default.
# Compose refuses to start until this is set (fail-closed).
HINDSIGHT_DB_PASSWORD=

HINDSIGHT_DB_NAME=hindsight

# Override if an upstream Hindsight image becomes available.
HINDSIGHT_IMAGE=pgvector/pgvector:pg16

# =============================================================================
# REMINDER: .env must be listed in .gitignore. Never commit real secrets,
# tokens, or API keys. This file (`.env.example`) is the only committed
# template and must contain placeholder values only.
# =============================================================================
